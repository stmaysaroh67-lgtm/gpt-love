{
    "name": "AI Stealth Gateway",
    "build": {
        "dockerfile": "Dockerfile"
    },
    
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb"
    },
    
    "forwardPorts": [3001],
    "portsAttributes": {
        "3001": {
            "label": "API Gateway",
            "visibility": "public"
        }
    },
    
    "updateContentCommand": "npm install && sudo npm install -g pm2",
    
    "postStartCommand": "pm2 delete all || true && pm2 start npm --name 'ai-gateway' -- start",
    
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": []
        }
    }
}
